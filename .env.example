# ─── LLM Providers (at least one required for pipeline) ─────────────────────
NOVITA_API_KEY=your_novita_api_key_here
NOVITA_BASE_URL=https://api.novita.ai/v3/openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=your_anthropic_api_key_here

GOOGLE_API_KEY=your_google_api_key_here

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# AWS Bedrock (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── Blynx Security (Required) ────────────────────────────────────────────────
BLYNX_API_KEY=your_blynx_api_key_here

# ─── Cost Guard ───────────────────────────────────────────────────────────────
MAX_DAILY_SPEND_USD=100.0
MAX_SESSION_SPEND_USD=10.0
MAX_SESSION_TOKENS=10000000

# ─── Redis (CPU↔GPU bridge + task store) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage
VECTOR_DB_PATH=./storage/vector_db
ARTIFACTS_PATH=./storage/artifacts

# ─── Security ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_random_secret_key_at_least_32_chars

# ─── Telemetry ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# ─── Telegram Bot (optional — task completion alerts) ────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
